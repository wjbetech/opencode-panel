{
  "name": "opencode-panel",
  "displayName": "OpenCode Panel",
  "description": "An OpenCode chat pane for the VS Code secondary sidebar: streamed answers, syntax-highlighted snippets, and a type-it-yourself workflow.",
  "version": "0.0.1",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:opencodePanel.view"
  ],
  "contributes": {
    "viewsContainers": {
      "auxiliarybar": [
        {
          "id": "opencodePanel",
          "title": "OpenCode",
          "icon": "media/opencode.svg"
        }
      ]
    },
    "views": {
      "opencodePanel": [
        {
          "type": "webview",
          "id": "opencodePanel.view",
          "name": "OpenCode",
          "icon": "media/opencode.svg",
          "contextualTitle": "OpenCode"
        }
      ]
    },
    "chatSessions": [
      {
        "type": "opencode",
        "name": "opencode",
        "displayName": "OpenCode",
        "description": "Sessions from the local OpenCode server",
        "icon": "$(comment-discussion)"
      }
    ],
    "commands": [
      {
        "command": "opencodePanel.open",
        "title": "OpenCode: Open the OpenCode Pane",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "opencodePanel.newSession",
        "title": "OpenCode: New Session in Pane",
        "icon": "$(add)"
      },
      {
        "command": "opencodePanel.pickSession",
        "title": "OpenCode: Open Existing Session in Pane",
        "icon": "$(history)"
      },
      {
        "command": "opencodePanel.refresh",
        "title": "OpenCode: Refresh Pane",
        "icon": "$(refresh)"
      },
      {
        "command": "opencodePanel.reloadWebview",
        "title": "OpenCode: Reload Pane Webview",
        "icon": "$(sync)"
      },
      {
        "command": "opencodePanel.importChat",
        "title": "OpenCode: Import VS Code Chat into Pane",
        "icon": "$(cloud-download)"
      },
      {
        "command": "opencodePanel.backportChat",
        "title": "OpenCode: Backport Pane Session to VS Code Chat",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "opencodePanel.openInChat",
        "title": "OpenCode: Open Session in VS Code Chat",
        "icon": "$(open-preview)"
      },
      {
        "command": "opencodePanel.showStatus",
        "title": "OpenCode: Show Pane Diagnostics",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencodePanel.openInChat",
          "when": "view == opencodePanel.view",
          "group": "navigation@1"
        },
        {
          "command": "opencodePanel.showStatus",
          "when": "view == opencodePanel.view",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode Panel",
      "properties": {
        "opencodePanel.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override the OpenCode server URL (for example `http://127.0.0.1:4096`). Leave empty to auto-discover the local background service from its registration file.",
          "scope": "window"
        },
        "opencodePanel.agent": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional agent ID to use for new sessions. Leave empty to use the server default.",
          "scope": "window"
        },
        "opencodePanel.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional model to use for new sessions, as `provider/model` (for example `opencode/deepseek-v4.1-flash-free`). Leave empty to use the server default.",
          "scope": "window"
        },
        "opencodePanel.showReasoning": {
          "type": "boolean",
          "default": false,
          "description": "Show model reasoning (thinking) parts in the panel.",
          "scope": "window"
        },
        "opencodePanel.stripColorEmoji": {
          "type": "boolean",
          "default": true,
          "description": "Strip color-square emojis (🟥 🟦 ⬛) from model output. CSS snippets already show real color swatches, so the emojis are redundant.",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --out opencode-panel.vsix",
    "deploy": "pnpm run build && pnpm run package && code --install-extension ./opencode-panel.vsix --force && pnpm run enable-proposed-api",
    "enable-proposed-api": "node scripts/enable-proposed-api.mjs",
    "smoke": "node dist/smoke.mjs",
    "inspect": "node dist/inspect.mjs",
    "handoff": "node esbuild.mjs && node dist/handoff.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@opencode/client": "2.0.32",
    "dompurify": "^3.2.7",
    "highlight.js": "^11.11.1",
    "marked": "^16.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
